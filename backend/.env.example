# Example environment values for local development (do not commit real secrets)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Admin feedback (optional)
ADMIN_FEEDBACK_TOKEN=replace_with_random_token

# Firebase auth (optional)
FIREBASE_AUTH_DISABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_PATH=backend/secrets/firebase-service-account.json

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Limits / tuning (optional)
MAX_REQUEST_BYTES=524288
PCOSINA_FORCE_RESEED=false
PCOSINA_MILP_WEIGHTS=
PCOSINA_SEED_SALT=
PCOSINA_WEIGHT_GRID=false
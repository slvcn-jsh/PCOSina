# Leave blank for LAN phone testing. The web app infers:
# http://localhost:5173 -> http://localhost:8000
# http://192.168.x.x:5173 -> http://192.168.x.x:8000
# Set this only for a deployed HTTPS backend.
VITE_PCOSINA_API_BASE_URL=

# Optional Firebase web app config. Guest mode works without these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=pcosina
VITE_FIREBASE_STORAGE_BUCKET=pcosina.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=950408114415
VITE_FIREBASE_APP_ID=

# Optional App Check reCAPTCHA v3 site key for protected backend environments.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

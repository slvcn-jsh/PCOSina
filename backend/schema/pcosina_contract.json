{
  "schemaVersion": "1.5.0",
  "title": "PCOSINA API Contract",
  "description": "Shared request/response contract for PCOSINA backend and mobile client.",
  "type": "object",
  "properties": {
    "GeneratePlanRequest": {
      "type": "object",
      "properties": {
        "profile": { "$ref": "#/definitions/UserProfile" },
        "days": { "type": "integer", "minimum": 1, "default": 7 },
        "mealsPerDay": { "type": "integer", "minimum": 1, "default": 3 }
      },
      "required": ["profile"],
      "additionalProperties": false
    },
    "GeneratePlanResponse": {
      "type": "object",
      "properties": {
        "weekLabel": { "type": "string" },
        "days": {
          "type": "array",
          "items": { "$ref": "#/definitions/DayPlan" }
        },
        "status": { "type": "string" },
        "message": { "type": "string" },
        "explanation": { "$ref": "#/definitions/PlanExplanation" },
        "requestId": { "type": ["string", "null"] },
        "planId": { "type": ["string", "null"] },
        "groceryOutput": { "type": ["object", "null"] },
        "pantryUsageSummary": { "type": ["object", "null"] },
        "nutritionSummary": { "type": ["object", "null"] },
        "solverMetadata": { "type": ["object", "null"] },
        "policyVersion": { "type": ["string", "null"] },
        "diagnosticsSummary": { "type": ["object", "null"] },
        "machineReasonCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "humanGuidance": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggestedRelaxations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "diagnosticsReference": { "type": ["string", "null"] },
        "timestamps": { "type": ["object", "null"] }
      },
      "required": ["weekLabel", "days", "status", "message"],
      "additionalProperties": false
    },
    "FeedbackRequest": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "required": ["message"],
      "additionalProperties": false
    },
    "MLClientEventRequest": {
      "type": "object",
      "properties": {
        "eventName": { "type": "string", "minLength": 1 },
        "requestId": { "type": ["string", "null"] },
        "payload": { "type": "object" }
      },
      "required": ["eventName"],
      "additionalProperties": false
    },
    "HealthResponse": {
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      },
      "required": ["status"],
      "additionalProperties": false
    }
  },
  "definitions": {
    "UserProfile": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "age": { "type": "integer", "minimum": 0 },
        "heightCm": { "type": "integer", "minimum": 0 },
        "weightKg": { "type": "integer", "minimum": 0 },
        "heightUnit": { "type": "string" },
        "weightUnit": { "type": "string" },
        "activityLevel": { "type": "string" },
        "goal": { "type": "string" },
        "dietaryRestrictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pantryItems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "budgetWeekly": { "type": ["number", "null"] },
        "budgetMonthly": { "type": ["number", "null"] },
        "insulinResistanceLevel": { "type": "string" },
        "symptoms": { "type": "array", "items": { "type": "string" } },
        "comorbidities": { "type": "array", "items": { "type": "string" } },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "weeklyBudgetPhp": { "type": "integer" },
        "maxCookingTimeMinutes": { "type": "integer" },
        "varietyPreference": { "type": "string" },
        "planningPriority": { "type": "string" },
        "isProfileCompleted": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "DayPlan": {
      "type": "object",
      "properties": {
        "dayLabel": { "type": "string" },
        "meals": {
          "type": "array",
          "items": { "$ref": "#/definitions/PlannedMeal" }
        },
        "totalCalories": { "type": "integer" }
      },
      "required": ["dayLabel", "meals", "totalCalories"],
      "additionalProperties": false
    },
    "PlannedMeal": {
      "type": "object",
      "properties": {
        "mealLabel": { "type": "string" },
        "recipeId": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["mealLabel", "recipeId", "title"],
      "additionalProperties": false
    },
    "PlanExplanation": {
      "type": ["object", "null"],
      "properties": {
        "fallbackUsed": { "type": "boolean" },
        "authority": { "type": "string" },
        "confidenceScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "targetCalories": { "type": "integer" },
        "avgCalories": { "type": "integer" },
        "avgCaloriesDeviation": { "type": "integer" },
        "targetProtein": { "type": "integer" },
        "avgProtein": { "type": "integer" },
        "targetCarbs": { "type": "integer" },
        "avgCarbs": { "type": "integer" },
        "targetFats": { "type": "integer" },
        "avgFats": { "type": "integer" },
        "toleranceUsed": { "type": "number" },
        "maxPerWeek": { "type": "integer" },
        "pantryMatches": { "type": "integer" },
        "uniqueVegTokens": { "type": "integer" },
        "budgetWeekly": { "type": ["number", "null"] },
        "estimatedWeeklyCost": { "type": "integer" },
        "restrictionCount": { "type": "integer" },
        "candidatePoolSize": { "type": "integer" },
        "selectedMeals": { "type": "integer" },
        "budgetHardCapApplied": { "type": "boolean" },
        "householdPlanningMode": { "type": "string" },
        "goalValue": { "type": "string" },
        "symptomSelections": {
          "type": "array",
          "items": { "type": "string" }
        },
        "profileRuleEffects": {
          "type": "object",
          "properties": {
            "hardFilters": {
              "type": "array",
              "items": { "type": "string" }
            },
            "softDrivers": {
              "type": "array",
              "items": { "type": "string" }
            },
            "shoppingFactors": {
              "type": "array",
              "items": { "type": "string" }
            },
            "trackingOnly": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "symptomStrategy": {
          "type": "array",
          "items": { "type": "string" }
        },
        "candidateExclusionSummary": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "selectionReasonsByRecipeId": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "selectionReasonCounts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "fiberMinTarget": { "type": ["integer", "null"] },
        "sugarMaxTarget": { "type": ["integer", "null"] },
        "goalStrategy": {
          "type": "array",
          "items": { "type": "string" }
        },
        "solverStatus": { "type": "string" },
        "retryAttemptsUsed": { "type": "integer" },
        "phaseTimingsMs": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "solverBudget": {
          "type": "object",
          "additionalProperties": {
            "type": ["integer", "number", "string", "boolean", "null"]
          }
        },
        "solvePairDiagnostics": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": false
    }
  }
}
